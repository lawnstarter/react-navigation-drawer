{
  "name": "react-navigation-drawer",
  "version": "2.4.1",
  "description": "Drawer navigator component for React Navigation",
  "main": "src/index.tsx",
  "react-native": "src/index.tsx",
  "source": "src/index.tsx",
  "files": [
    "src",
    "lib"
  ],
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "test": "jest",
    "lint": "eslint --ext .js,.ts,.tsx .",
    "typescript": "tsc --noEmit",
    "example": "yarn --cwd example",
    "bootstrap": "yarn example && yarn",
    "build": "bob build"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "react-native-component",
    "react-component",
    "react-native",
    "ios",
    "android",
    "drawer",
    "material"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/react-navigation/drawer.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/react-navigation/drawer/issues"
  },
  "homepage": "https://github.com/react-navigation/drawer#readme",
  "devDependencies": {
    "@babel/core": "7.29.6",
    "@commitlint/config-conventional": "^7.5.0",
    "@expo/vector-icons": "^10.0.1",
    "@react-native-community/bob": "^0.3.4",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "12.9.0",
    "@types/jest": "^30.0.0",
    "@types/react": "19.2.18",
    "babel-jest": "^30.1.2",
    "commitlint": "^7.5.2",
    "escape-string-regexp": "^1.0.5",
    "eslint": "^5.16.0",
    "eslint-config-satya164": "^2.4.1",
    "eslint-plugin-react-native-globals": "^0.1.0",
    "husky": "^1.3.1",
    "jest": "30.1.3",
    "prettier": "^1.19.1",
    "react": "19.2.3",
    "react-lifecycles-compat": "^3.0.4",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-screens": "^4.0.0",
    "react-native-worklets": "0.10.1",
    "react-navigation": "^4.0.7",
    "react-test-renderer": "19.2.3",
    "typescript": "5.9.2"
  },
  "dependencies": {},
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-gesture-handler": "^2.32.0",
    "react-native-reanimated": "^4.5.1",
    "react-native-screens": "^4.0.0",
    "react-native-worklets": "^0.10.1",
    "react-navigation": "^4.0.7"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "setupFiles": [
      "./node_modules/react-native-gesture-handler/jestSetup.js",
      "<rootDir>/jest-setup.js"
    ],
    "coveragePathIgnorePatterns": [
      "jest-setup.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/example/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?(@react-native|react-native)|react-navigation|@react-navigation/core|@react-navigation/native)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/lib/"
    ],
    "testRegex": "/__tests__/.*\\.(test|spec)\\.(js|tsx?)$",
    "transform": {
      "^.+\\.(js|ts|tsx)$": "babel-jest"
    },
    "resolver": "react-native-worklets/jest/resolver"
  },
  "husky": {
    "hooks": {
      "pre-commit": "yarn build && yarn lint && yarn typescript && yarn test",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "@react-native-community/bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  }
}
